{
  "version": "1.0",
  "variables": {
    "--background": { "type": "color", "value": "#FAFAFA" },
    "--foreground": { "type": "color", "value": "#0F0F10" },
    "--card": { "type": "color", "value": "#FFFFFF" },
    "--muted": { "type": "color", "value": "#F4F4F5" },
    "--muted-foreground": { "type": "color", "value": "#71717A" },
    "--border": { "type": "color", "value": "#E4E4E7" },
    "--primary": { "type": "color", "value": "#18181B" },
    "--primary-foreground": { "type": "color", "value": "#FAFAFA" },
    "--destructive": { "type": "color", "value": "#EF4444" },
    "--font-sans": { "type": "string", "value": "Inter" },
    "--font-mono": { "type": "string", "value": "JetBrains Mono" }
  },
  "children": [
    {
      "id": "settings-screen",
      "name": "Settings Page",
      "type": "frame",
      "layout": "vertical",
      "width": 800,
      "height": "fit_content(1200)",
      "fill": "$--background",
      "padding": [32, 40],
      "gap": 32,
      "children": [
        {
          "id": "page-title",
          "type": "text",
          "content": "Settings",
          "fontFamily": "$--font-sans",
          "fontSize": 28,
          "fontWeight": "700",
          "fill": "$--foreground"
        },

        {
          "id": "color-theme-section",
          "type": "frame",
          "layout": "vertical",
          "width": "fill_container",
          "height": "fit_content",
          "gap": 16,
          "children": [
            {
              "id": "color-theme-heading",
              "type": "text",
              "content": "Color Theme",
              "fontFamily": "$--font-sans",
              "fontSize": 18,
              "fontWeight": "600",
              "fill": "$--foreground"
            },
            {
              "id": "radio-group",
              "type": "frame",
              "layout": "vertical",
              "width": "fill_container",
              "height": "fit_content",
              "gap": 0,
              "children": [
                {
                  "id": "radio-option-1",
                  "name": "Default Slate (Selected)",
                  "type": "frame",
                  "layout": "horizontal",
                  "width": "fill_container",
                  "height": "fit_content",
                  "padding": [14, 16],
                  "gap": 14,
                  "alignItems": "center",
                  "fill": "$--card",
                  "cornerRadius": [8, 8, 0, 0],
                  "stroke": { "align": "inside", "thickness": 1, "fill": "$--border" },
                  "children": [
                    {
                      "id": "radio-indicator-1",
                      "name": "Radio Selected",
                      "type": "frame",
                      "layout": "none",
                      "width": 18,
                      "height": 18,
                      "children": [
                        {
                          "id": "radio-circle-1",
                          "type": "ellipse",
                          "width": 18,
                          "height": 18,
                          "x": 0,
                          "y": 0,
                          "stroke": { "align": "inside", "thickness": 2, "fill": "$--primary" }
                        },
                        {
                          "id": "radio-dot-1",
                          "type": "ellipse",
                          "width": 8,
                          "height": 8,
                          "fill": "$--primary",
                          "x": 5,
                          "y": 5
                        }
                      ]
                    },
                    {
                      "id": "swatch-group-1",
                      "type": "frame",
                      "layout": "horizontal",
                      "width": "fit_content",
                      "height": "fit_content",
                      "gap": 4,
                      "alignItems": "center",
                      "children": [
                        {
                          "id": "swatch-1a",
                          "type": "ellipse",
                          "width": 10,
                          "height": 10,
                          "fill": "#71717A"
                        },
                        {
                          "id": "swatch-1b",
                          "type": "ellipse",
                          "width": 10,
                          "height": 10,
                          "fill": "#18181B"
                        },
                        {
                          "id": "swatch-1c",
                          "type": "ellipse",
                          "width": 10,
                          "height": 10,
                          "fill": "#3B82F6"
                        }
                      ]
                    },
                    {
                      "id": "radio-text-group-1",
                      "type": "frame",
                      "layout": "vertical",
                      "width": "fill_container",
                      "height": "fit_content",
                      "gap": 2,
                      "children": [
                        {
                          "id": "radio-name-1",
                          "type": "text",
                          "content": "Default Slate",
                          "fontFamily": "$--font-sans",
                          "fontSize": 14,
                          "fontWeight": "500",
                          "fill": "$--foreground"
                        },
                        {
                          "id": "radio-desc-1",
                          "type": "text",
                          "content": "Cool blue-gray tones with a professional feel",
                          "fontFamily": "$--font-sans",
                          "fontSize": 12,
                          "fill": "$--muted-foreground"
                        }
                      ]
                    }
                  ]
                },

                {
                  "id": "radio-option-2",
                  "name": "Kodama Grove",
                  "type": "frame",
                  "layout": "horizontal",
                  "width": "fill_container",
                  "height": "fit_content",
                  "padding": [14, 16],
                  "gap": 14,
                  "alignItems": "center",
                  "fill": "$--card",
                  "stroke": { "align": "inside", "thickness": { "top": 0, "right": 1, "bottom": 1, "left": 1 }, "fill": "$--border" },
                  "children": [
                    {
                      "id": "radio-indicator-2",
                      "name": "Radio Unselected",
                      "type": "frame",
                      "layout": "none",
                      "width": 18,
                      "height": 18,
                      "children": [
                        {
                          "id": "radio-circle-2",
                          "type": "ellipse",
                          "width": 18,
                          "height": 18,
                          "x": 0,
                          "y": 0,
                          "stroke": { "align": "inside", "thickness": 1.5, "fill": "$--border" }
                        }
                      ]
                    },
                    {
                      "id": "swatch-group-2",
                      "type": "frame",
                      "layout": "horizontal",
                      "width": "fit_content",
                      "height": "fit_content",
                      "gap": 4,
                      "alignItems": "center",
                      "children": [
                        {
                          "id": "swatch-2a",
                          "type": "ellipse",
                          "width": 10,
                          "height": 10,
                          "fill": "#22C55E"
                        },
                        {
                          "id": "swatch-2b",
                          "type": "ellipse",
                          "width": 10,
                          "height": 10,
                          "fill": "#166534"
                        },
                        {
                          "id": "swatch-2c",
                          "type": "ellipse",
                          "width": 10,
                          "height": 10,
                          "fill": "#A3E635"
                        }
                      ]
                    },
                    {
                      "id": "radio-text-group-2",
                      "type": "frame",
                      "layout": "vertical",
                      "width": "fill_container",
                      "height": "fit_content",
                      "gap": 2,
                      "children": [
                        {
                          "id": "radio-name-2",
                          "type": "text",
                          "content": "Kodama Grove",
                          "fontFamily": "$--font-sans",
                          "fontSize": 14,
                          "fontWeight": "500",
                          "fill": "$--foreground"
                        },
                        {
                          "id": "radio-desc-2",
                          "type": "text",
                          "content": "Fresh green palette inspired by nature",
                          "fontFamily": "$--font-sans",
                          "fontSize": 12,
                          "fill": "$--muted-foreground"
                        }
                      ]
                    }
                  ]
                },

                {
                  "id": "radio-option-3",
                  "name": "Cosmic Night",
                  "type": "frame",
                  "layout": "horizontal",
                  "width": "fill_container",
                  "height": "fit_content",
                  "padding": [14, 16],
                  "gap": 14,
                  "alignItems": "center",
                  "fill": "$--card",
                  "stroke": { "align": "inside", "thickness": { "top": 0, "right": 1, "bottom": 1, "left": 1 }, "fill": "$--border" },
                  "children": [
                    {
                      "id": "radio-indicator-3",
                      "name": "Radio Unselected",
                      "type": "frame",
                      "layout": "none",
                      "width": 18,
                      "height": 18,
                      "children": [
                        {
                          "id": "radio-circle-3",
                          "type": "ellipse",
                          "width": 18,
                          "height": 18,
                          "x": 0,
                          "y": 0,
                          "stroke": { "align": "inside", "thickness": 1.5, "fill": "$--border" }
                        }
                      ]
                    },
                    {
                      "id": "swatch-group-3",
                      "type": "frame",
                      "layout": "horizontal",
                      "width": "fit_content",
                      "height": "fit_content",
                      "gap": 4,
                      "alignItems": "center",
                      "children": [
                        {
                          "id": "swatch-3a",
                          "type": "ellipse",
                          "width": 10,
                          "height": 10,
                          "fill": "#8B5CF6"
                        },
                        {
                          "id": "swatch-3b",
                          "type": "ellipse",
                          "width": 10,
                          "height": 10,
                          "fill": "#6366F1"
                        },
                        {
                          "id": "swatch-3c",
                          "type": "ellipse",
                          "width": 10,
                          "height": 10,
                          "fill": "#EC4899"
                        }
                      ]
                    },
                    {
                      "id": "radio-text-group-3",
                      "type": "frame",
                      "layout": "vertical",
                      "width": "fill_container",
                      "height": "fit_content",
                      "gap": 2,
                      "children": [
                        {
                          "id": "radio-name-3",
                          "type": "text",
                          "content": "Cosmic Night",
                          "fontFamily": "$--font-sans",
                          "fontSize": 14,
                          "fontWeight": "500",
                          "fill": "$--foreground"
                        },
                        {
                          "id": "radio-desc-3",
                          "type": "text",
                          "content": "Deep purples and indigo with pink accents",
                          "fontFamily": "$--font-sans",
                          "fontSize": 12,
                          "fill": "$--muted-foreground"
                        }
                      ]
                    }
                  ]
                },

                {
                  "id": "radio-option-4",
                  "name": "Midnight Bloom",
                  "type": "frame",
                  "layout": "horizontal",
                  "width": "fill_container",
                  "height": "fit_content",
                  "padding": [14, 16],
                  "gap": 14,
                  "alignItems": "center",
                  "fill": "$--card",
                  "cornerRadius": [0, 0, 8, 8],
                  "stroke": { "align": "inside", "thickness": { "top": 0, "right": 1, "bottom": 1, "left": 1 }, "fill": "$--border" },
                  "children": [
                    {
                      "id": "radio-indicator-4",
                      "name": "Radio Unselected",
                      "type": "frame",
                      "layout": "none",
                      "width": 18,
                      "height": 18,
                      "children": [
                        {
                          "id": "radio-circle-4",
                          "type": "ellipse",
                          "width": 18,
                          "height": 18,
                          "x": 0,
                          "y": 0,
                          "stroke": { "align": "inside", "thickness": 1.5, "fill": "$--border" }
                        }
                      ]
                    },
                    {
                      "id": "swatch-group-4",
                      "type": "frame",
                      "layout": "horizontal",
                      "width": "fit_content",
                      "height": "fit_content",
                      "gap": 4,
                      "alignItems": "center",
                      "children": [
                        {
                          "id": "swatch-4a",
                          "type": "ellipse",
                          "width": 10,
                          "height": 10,
                          "fill": "#F43F5E"
                        },
                        {
                          "id": "swatch-4b",
                          "type": "ellipse",
                          "width": 10,
                          "height": 10,
                          "fill": "#E11D48"
                        },
                        {
                          "id": "swatch-4c",
                          "type": "ellipse",
                          "width": 10,
                          "height": 10,
                          "fill": "#9333EA"
                        }
                      ]
                    },
                    {
                      "id": "radio-text-group-4",
                      "type": "frame",
                      "layout": "vertical",
                      "width": "fill_container",
                      "height": "fit_content",
                      "gap": 2,
                      "children": [
                        {
                          "id": "radio-name-4",
                          "type": "text",
                          "content": "Midnight Bloom",
                          "fontFamily": "$--font-sans",
                          "fontSize": 14,
                          "fontWeight": "500",
                          "fill": "$--foreground"
                        },
                        {
                          "id": "radio-desc-4",
                          "type": "text",
                          "content": "Rose and magenta with deep purple undertones",
                          "fontFamily": "$--font-sans",
                          "fontSize": 12,
                          "fill": "$--muted-foreground"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },

        {
          "id": "tax-settings-card",
          "name": "Tax Settings",
          "type": "frame",
          "layout": "vertical",
          "width": "fill_container",
          "height": "fit_content",
          "fill": "$--card",
          "cornerRadius": 8,
          "stroke": { "align": "inside", "thickness": 1, "fill": "$--border" },
          "padding": 20,
          "gap": 20,
          "children": [
            {
              "id": "tax-card-heading",
              "type": "text",
              "content": "Tax Settings",
              "fontFamily": "$--font-sans",
              "fontSize": 16,
              "fontWeight": "600",
              "fill": "$--foreground"
            },
            {
              "id": "tax-percent-field",
              "name": "Tax % Field",
              "type": "frame",
              "layout": "vertical",
              "width": "fill_container",
              "height": "fit_content",
              "gap": 6,
              "children": [
                {
                  "id": "tax-percent-label",
                  "type": "text",
                  "content": "Tax %",
                  "fontFamily": "$--font-sans",
                  "fontSize": 14,
                  "fontWeight": "500",
                  "fill": "$--foreground"
                },
                {
                  "id": "tax-percent-input",
                  "type": "frame",
                  "layout": "horizontal",
                  "width": "fill_container",
                  "height": "fit_content",
                  "padding": [8, 12],
                  "cornerRadius": 6,
                  "stroke": { "align": "inside", "thickness": 1, "fill": "$--border" },
                  "fill": "$--background",
                  "alignItems": "center",
                  "children": [
                    {
                      "id": "tax-percent-value",
                      "type": "text",
                      "content": "12",
                      "fontFamily": "$--font-mono",
                      "fontSize": 14,
                      "fill": "$--foreground"
                    }
                  ]
                },
                {
                  "id": "tax-percent-desc",
                  "type": "text",
                  "content": "Applied to all transactions",
                  "fontFamily": "$--font-sans",
                  "fontSize": 12,
                  "fill": "$--muted-foreground"
                }
              ]
            },
            {
              "id": "charge-tax-field",
              "name": "Charge Tax Field",
              "type": "frame",
              "layout": "horizontal",
              "width": "fill_container",
              "height": "fit_content",
              "gap": 12,
              "alignItems": "center",
              "justifyContent": "space_between",
              "children": [
                {
                  "id": "charge-tax-label-group",
                  "type": "frame",
                  "layout": "vertical",
                  "width": "fill_container",
                  "height": "fit_content",
                  "gap": 2,
                  "children": [
                    {
                      "id": "charge-tax-label",
                      "type": "text",
                      "content": "Charge Tax",
                      "fontFamily": "$--font-sans",
                      "fontSize": 14,
                      "fontWeight": "500",
                      "fill": "$--foreground"
                    },
                    {
                      "id": "charge-tax-desc",
                      "type": "text",
                      "content": "Enable tax collection on sales",
                      "fontFamily": "$--font-sans",
                      "fontSize": 12,
                      "fill": "$--muted-foreground"
                    }
                  ]
                },
                {
                  "id": "toggle-switch",
                  "name": "Toggle On",
                  "type": "frame",
                  "layout": "none",
                  "width": 44,
                  "height": 24,
                  "cornerRadius": 12,
                  "fill": "$--primary",
                  "children": [
                    {
                      "id": "toggle-thumb",
                      "type": "ellipse",
                      "width": 20,
                      "height": 20,
                      "fill": "#FFFFFF",
                      "x": 22,
                      "y": 2
                    }
                  ]
                }
              ]
            },
            {
              "id": "tax-number-field",
              "name": "Tax Number Field",
              "type": "frame",
              "layout": "vertical",
              "width": "fill_container",
              "height": "fit_content",
              "gap": 6,
              "children": [
                {
                  "id": "tax-number-label",
                  "type": "text",
                  "content": "Tax Number",
                  "fontFamily": "$--font-sans",
                  "fontSize": 14,
                  "fontWeight": "500",
                  "fill": "$--foreground"
                },
                {
                  "id": "tax-number-input",
                  "type": "frame",
                  "layout": "horizontal",
                  "width": "fill_container",
                  "height": "fit_content",
                  "padding": [8, 12],
                  "cornerRadius": 6,
                  "stroke": { "align": "inside", "thickness": 1, "fill": "$--border" },
                  "fill": "$--background",
                  "alignItems": "center",
                  "children": [
                    {
                      "id": "tax-number-value",
                      "type": "text",
                      "content": "123-456-789",
                      "fontFamily": "$--font-mono",
                      "fontSize": 14,
                      "fill": "$--foreground"
                    }
                  ]
                }
              ]
            }
          ]
        },

        {
          "id": "store-info-card",
          "name": "Store Info",
          "type": "frame",
          "layout": "vertical",
          "width": "fill_container",
          "height": "fit_content",
          "fill": "$--card",
          "cornerRadius": 8,
          "stroke": { "align": "inside", "thickness": 1, "fill": "$--border" },
          "padding": 20,
          "gap": 20,
          "children": [
            {
              "id": "store-card-heading",
              "type": "text",
              "content": "Store Info",
              "fontFamily": "$--font-sans",
              "fontSize": 16,
              "fontWeight": "600",
              "fill": "$--foreground"
            },
            {
              "id": "store-name-field",
              "name": "Store Name Field",
              "type": "frame",
              "layout": "vertical",
              "width": "fill_container",
              "height": "fit_content",
              "gap": 6,
              "children": [
                {
                  "id": "store-name-label",
                  "type": "text",
                  "content": "Store Name",
                  "fontFamily": "$--font-sans",
                  "fontSize": 14,
                  "fontWeight": "500",
                  "fill": "$--foreground"
                },
                {
                  "id": "store-name-input",
                  "type": "frame",
                  "layout": "horizontal",
                  "width": "fill_container",
                  "height": "fit_content",
                  "padding": [8, 12],
                  "cornerRadius": 6,
                  "stroke": { "align": "inside", "thickness": 1, "fill": "$--border" },
                  "fill": "$--background",
                  "alignItems": "center",
                  "children": [
                    {
                      "id": "store-name-value",
                      "type": "text",
                      "content": "My Coffee Shop",
                      "fontFamily": "$--font-sans",
                      "fontSize": 14,
                      "fill": "$--foreground"
                    }
                  ]
                }
              ]
            },
            {
              "id": "currency-field",
              "name": "Currency Field",
              "type": "frame",
              "layout": "vertical",
              "width": "fill_container",
              "height": "fit_content",
              "gap": 6,
              "children": [
                {
                  "id": "currency-label",
                  "type": "text",
                  "content": "Currency",
                  "fontFamily": "$--font-sans",
                  "fontSize": 14,
                  "fontWeight": "500",
                  "fill": "$--foreground"
                },
                {
                  "id": "currency-input",
                  "type": "frame",
                  "layout": "horizontal",
                  "width": "fill_container",
                  "height": "fit_content",
                  "padding": [8, 12],
                  "cornerRadius": 6,
                  "stroke": { "align": "inside", "thickness": 1, "fill": "$--border" },
                  "fill": "$--background",
                  "alignItems": "center",
                  "children": [
                    {
                      "id": "currency-value",
                      "type": "text",
                      "content": "\u20b1 (PHP)",
                      "fontFamily": "$--font-mono",
                      "fontSize": 14,
                      "fill": "$--foreground"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}